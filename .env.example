# ----- Search feeds -----
# Category folders: config/<category>/ (queries + Gemini prompts)
# Shared site lists: config/international_sites.txt, config/korean_sites.txt
# Article count is set in the GUI (python gui.py).

# Google News locale per feed.
NEWS_LANG=en-US
NEWS_COUNTRY=US
NEWS_LANG_KR=ko-KR
NEWS_COUNTRY_KR=KR

# De-duplication: collapse near-identical stories across both feeds.
DEDUPE=true
DEDUPE_THRESHOLD=0.5

# ----- Gemini (Google AI) -----
# Get a free API key at https://aistudio.google.com/app/apikey
# Prompts live in config/<category>/gemini_system_prompt.txt etc.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest
SUMMARY_LANGUAGE=Korean

# ----- Web board (optional) -----
# How long to keep articles in data/board_history.json
BOARD_RETENTION_DAYS=14
# Only ingest articles published within this many days
BOARD_ARTICLE_MAX_AGE_DAYS=3
# Max Gemini calls per Refresh for unscored items (0 = no cap, score all)
BOARD_MAX_NEW_SUMMARIES=0
# Whitelist file: config/international_sites.txt (domain | feed_url)

# ----- Email (Outlook / Office365) -----
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
EMAIL_ADDRESS=you@outlook.com
EMAIL_PASSWORD=your_email_password_or_app_password
# EMAIL_TO is optional; the GUI lets you enter recipients each run.
# If the field is left blank in the GUI, it falls back to EMAIL_TO or EMAIL_ADDRESS.
EMAIL_TO=
